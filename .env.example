# Environment Configuration Template for CyberGuard AI
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security Secrets (Must be overridden in production)
SECRET_KEY=replace_with_a_secure_random_64_character_hex_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=cyberguard
POSTGRES_PASSWORD=cyberguard_secret
POSTGRES_DB=cyberguard_db
POSTGRES_PORT=5432

# Redis Queue & Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Async Ingestion Queue Settings
ASYNC_INGESTION_ENABLED=True
QUEUE_NAME=cyberguard:events:queue
DLQ_NAME=cyberguard:events:dlq
MAX_RETRIES=3
EVENT_IDEMPOTENCY_TTL_SECONDS=86400
