# --- CyberGuard AI Production Environment Variables ---

ENVIRONMENT=production
LOG_LEVEL=INFO

# Database Configuration (TimescaleDB / PostgreSQL 16)
POSTGRES_USER=cyberguard
POSTGRES_PASSWORD=ReplaceWithStrongPassword2026!
POSTGRES_DB=cyberguard
DATABASE_URL=postgresql://cyberguard:ReplaceWithStrongPassword2026!@timescaledb:5432/cyberguard

# Redis Broker & State Store
REDIS_URL=redis://redis:6379/0

# Security & Cryptography
JWT_SECRET=ReplaceWithAtLeast32ByteRandomHexKey2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["https://security.yourdomain.com", "http://localhost"]

# Threat Intelligence TAXII 2.1 Feeds
TAXII_FEED_URL=https://cti-taxii.mitre.org/taxii/
TAXII_COLLECTION_ID=95ecc380-afe9-11e4-9b6c-751b66dd541e
TAXII_USER=
TAXII_PASSWORD=
